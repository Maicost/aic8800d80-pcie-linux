diff -ruN a/drivers/aic8800/aic8800_fdrv/Makefile b/drivers/aic8800/aic8800_fdrv/Makefile
--- a/drivers/aic8800/aic8800_fdrv/Makefile	2026-10-15 11:00:20.723065664 -0300
+++ b/drivers/aic8800/aic8800_fdrv/Makefile	2026-11-13 09:36:14.038335771 -0300
@@ -193,6 +193,19 @@
 ccflags-$(CONFIG_DEBUG_FS) += -DCONFIG_RWNX_UM_HELPER_DFLT=\"$(CONFIG_RWNX_UM_HELPER_DFLT)\"
 ccflags-$(CONFIG_RWNX_P2P_DEBUGFS) += -DCONFIG_RWNX_P2P_DEBUGFS
 
+# API do cfg80211 detectada pelo header, nao pelo numero da versao: assim um
+# kernel com backport (ou o proximo do Fedora) cai no ramo certo sozinho.
+AIC_CFG_H := $(srctree)/include/net/cfg80211.h
+ifeq ($(shell grep -A3 '[*]mgmt_tx[^_]' $(AIC_CFG_H) 2>/dev/null | grep -q 'u64 cookie' && echo y),y)
+ccflags-y += -DAIC_CFG80211_COOKIE_BY_VALUE
+endif
+ifeq ($(shell grep -q '[*]probe_peer[^_]' $(AIC_CFG_H) 2>/dev/null && echo y),y)
+ccflags-y += -DAIC_CFG80211_PROBE_PEER
+endif
+ifeq ($(shell grep -A2 '^void cfg80211_probe_status' $(AIC_CFG_H) 2>/dev/null | grep -q 'link_id' && echo y),y)
+ccflags-y += -DAIC_CFG80211_PROBE_STATUS_LINK_ID
+endif
+
 # FW VARS
 ccflags-y += -DNX_VIRT_DEV_MAX=4
 
